# =====================================================================================
# AeroSync environment variables. Copy to `.env` (never commit it).
# Every variable is optional for Topology A (local Docker); defaults are shown.
# =====================================================================================

# ---------- Topology A: local Docker (docker compose up --build -d) ------------------
POSTGRES_DB=aerosync
POSTGRES_USER=aerosync_user
POSTGRES_PASSWORD=aerosync_password
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- OpenSky live ingestion ----------------------------------------------------
# false = boot straight into the flight simulator (no OpenSky calls at all).
OPENSKY_ENABLED=true
# 400/day anonymous, up to 4000/day with a free OpenSky account.
OPENSKY_DAILY_LIMIT=400
OPENSKY_POLL_INTERVAL_MS=60000
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_CONSECUTIVE_ERROR_THRESHOLD=3
OPENSKY_FAILOVER_COOLDOWN_MS=900000

# ---------- Simulator & free-tier storage protection ---------------------------------
SIMULATOR_INTERVAL_MS=3000
DB_PERSIST_INTERVAL_SECONDS=15
DB_RETENTION_HOURS=24
ACTIVE_FLIGHT_STALE_SECONDS=300

# ---------- Topology B: $0 cloud (Render/Koyeb backend + managed services) ------------
# PORT is injected by Render/Koyeb automatically.
#
# PostgreSQL (Neon / Aiven) - add ?sslMode=require
# SPRING_R2DBC_URL=r2dbc:postgresql://<host>:<port>/<db>?sslMode=require
# SPRING_R2DBC_USERNAME=
# SPRING_R2DBC_PASSWORD=
#
# Valkey / Redis over TLS (Aiven Valkey, Upstash). One URL carries user, password and TLS:
# SPRING_DATA_REDIS_URL=rediss://default:<password>@<host>:<port>
# ...or the split form:
# SPRING_DATA_REDIS_HOST=
# SPRING_DATA_REDIS_PORT=
# SPRING_DATA_REDIS_PASSWORD=
# SPRING_DATA_REDIS_SSL_ENABLED=true
#
# Kafka (Aiven free tier) with client certificates. Encode each file as one base64 line,
# e.g. `base64 -i ca.pem | tr -d '\n'`. The key must be PKCS#8 ("BEGIN PRIVATE KEY").
# SPRING_KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SSL
# KAFKA_CA_CERT_B64=
# KAFKA_CLIENT_CERT_B64=
# KAFKA_CLIENT_KEY_B64=
# ...or SASL_SSL:
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-256
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="avnadmin" password="<password>";
# KAFKA_TOPIC_REPLICATION_FACTOR=1
#
# Frontend on Vercel/Netlify: allow its origin(s).
# CORS_ALLOWED_ORIGINS=https://aerosync.vercel.app,https://*.netlify.app
