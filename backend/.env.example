# Backend-only environment variables (running the jar / `./mvnw spring-boot:run` outside Docker,
# or configuring a Render/Koyeb service). Docker Compose users can use the root .env.example instead.
# Every value is optional locally; defaults target docker-compose's Kafka/PostgreSQL/Valkey ports.

PORT=8080

# PostgreSQL (R2DBC). Cloud: r2dbc:postgresql://<host>:<port>/<db>?sslMode=require
SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5433/aerosync
SPRING_R2DBC_USERNAME=aerosync_user
SPRING_R2DBC_PASSWORD=aerosync_password

# Valkey / Redis. Cloud: SPRING_DATA_REDIS_URL=rediss://default:<password>@<host>:<port>
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_SSL_ENABLED=false
# SPRING_DATA_REDIS_URL=

# Kafka. Cloud (Aiven): SSL + base64 PEM certificates, or SASL_SSL.
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=PLAINTEXT
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-256
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=
# KAFKA_CA_CERT_B64=
# KAFKA_CLIENT_CERT_B64=
# KAFKA_CLIENT_KEY_B64=

# OpenSky Network (live feed) and automatic simulated fallback
OPENSKY_ENABLED=true
OPENSKY_DAILY_LIMIT=400
OPENSKY_POLL_INTERVAL_MS=60000
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Simulator and free-tier storage protection
SIMULATOR_INTERVAL_MS=3000
DB_PERSIST_INTERVAL_SECONDS=15
DB_RETENTION_HOURS=24
ACTIVE_FLIGHT_STALE_SECONDS=300

# CORS (comma separated, patterns allowed)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Observability
# Actuator endpoints exposed over HTTP (default shown).
MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics,prometheus
# Uncomment for JSON (ECS) console logs, useful with log aggregators:
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
