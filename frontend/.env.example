# Frontend build-time variables (Vite inlines them at `npm run build`).
#
# Local dev (`npm run dev`): leave both unset -> http://localhost:8080 and ws://localhost:8080/ws/telemetry.
# Docker Compose (Nginx proxy): leave both unset -> same-origin /api and /ws.
# Vercel / Netlify: set VITE_API_BASE_URL to the public backend URL. The WebSocket URL is derived
# from it (https -> wss) unless VITE_WS_URL is set explicitly.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=https://aerosync-backend.onrender.com
VITE_WS_URL=
# VITE_WS_URL=wss://aerosync-backend.onrender.com/ws/telemetry

# Optional basemap overrides (default: keyless Esri Dark/Light Gray Canvas).
# CARTO Dark Matter / Positron and Stadia need an API key, e.g.:
# VITE_MAP_TILE_DARK=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png?api_key=<key>
# VITE_MAP_TILE_LIGHT=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png?api_key=<key>
VITE_MAP_TILE_DARK=
VITE_MAP_TILE_LIGHT=
